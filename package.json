{
  "name": "books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:encapsulation": "bash scripts/check-encapsulation.sh",
    "test": "node --import tsx --test src/lib/dashboard.test.ts src/lib/book-search.test.ts src/lib/book-recommendations.test.ts src/lib/book-tags.test.ts src/lib/csv.test.ts src/lib/tag-similarity.test.ts src/lib/ingestion/workbook-parser.test.ts src/lib/open-library-images.test.ts src/lib/book-synopsis.test.ts",
    "validate:ingestion": "tsx --tsconfig tsconfig.json src/scripts/validate-ingestion.ts",
    "backfill:book-tags": "tsx --tsconfig tsconfig.json src/scripts/backfill-book-tags.ts",
    "enrich:open-library": "tsx --tsconfig tsconfig.json src/scripts/enrich-open-library-metadata.ts",
    "cleanup:books": "tsx --tsconfig tsconfig.json src/scripts/cleanup-invalid-books.ts",
    "postinstall": "prisma generate || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
