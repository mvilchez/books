// ---------------------------------------------------------------------------
// books — relational schema (PLAN.md Step 2.1)
//
// Stable Prisma (v6) + MariaDB, driven by Prisma's `mysql` provider (there is
// no "mariadb" provider — MariaDB uses the `mysql` provider).
// Use this file for local MariaDB or SkySQL/Aiven MariaDB cloud.
//
// Replaces the multi-tab Excel ledger with a normalized relational model:
//   Author (1) ──< Book (M) ──> Genre (0..1)
// Author names are de-duplicated into the Author table (1-to-Many); the Genre
// table powers the analytics rankings. The composite unique key keeps
// re-imports idempotent per reading year and edition, while preserving
// rereads in different years.
//
// Field mapping rationale (revised after Step 1.2 to match the real source):
//   rating          -> "Puntuación (del 1 al 10)" : decimal 1–10, Float?
//   totalPages      -> "Paginas"                  : nullable (pre-2014 gaps)
//   readingYear     -> derived from the TAB NAME  : NOT the publication year
//   publicationYear -> "Año" COLUMN (2014+ tabs)  : the book's original year
//   origin/startDate/finishDate -> Origen/Fecha Inicio/Fecha Fin columns
// ---------------------------------------------------------------------------

datasource db {
  provider = "postgresql" // MariaDB is driven by Prisma's "mysql" provider
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Reading lifecycle status for a book.
enum ReadingStatus {
  PENDING
  READING
  COMPLETED
  WISH_LIST
}

enum BookTagCategory {
  GENRE
  FORMAT
  LANGUAGE
  SUBJECT
  MOOD
}

enum BookTagSource {
  LIBRARY
  OPEN_LIBRARY
}

model Book {
  id                 String                  @id @default(uuid())
  title              String
  totalPages         Int?                    @map("numero_de_paginas") // nullable: pre-2014 gaps
  currentPages       Int                     @default(0)
  status             ReadingStatus           @default(PENDING)
  rating             Float?                  @map("nota_personal") // decimal 0–10 (1–10 scale)
  readingYear        Int                     @map("ano") // derived from the TAB NAME
  publicationYear    Int?                    @map("ano_publicacion") // from the "Año" COLUMN
  editionKey         String                  @default("") @map("edition_key")
  openLibraryCoverId Int?                    @map("open_library_cover_id")
  openLibraryWorkId  String?                 @map("open_library_work_id") @db.VarChar(32)
  isbn13             String?                 @map("isbn_13") @db.VarChar(13)
  bookFormat         String?                 @map("book_format") @db.VarChar(191)
  metadataCheckedAt  DateTime?               @map("metadata_checked_at")
  synopsis           String?                 @db.Text
  synopsisLanguage   String?                 @map("synopsis_language") @db.VarChar(12)
  synopsisSourceUrl  String?                 @map("synopsis_source_url") @db.Text
  synopsisCheckedAt  DateTime?               @map("synopsis_checked_at")
  seriesName         String?                 @map("series_name") @db.VarChar(191)
  seriesPosition     Float?                  @map("series_position")
  origin             String?                 @map("origen")
  startDate          DateTime?               @map("fecha_inicio")
  finishDate         DateTime?               @map("fecha_fin")
  authorId           String
  author             Author                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  genreId            String?
  genre              Genre?                  @relation(fields: [genreId], references: [id], onDelete: SetNull)
  tags               BookTag[]
  metadataCandidates BookMetadataCandidate[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Each row is a reading event: rereads in different years remain distinct,
  // while the same edition read in one year upserts idempotently.
  @@unique([title, authorId, readingYear, editionKey])
  @@index([readingYear, status])
}

model BookMetadataCandidate {
  id               String   @id @default(uuid())
  bookId           String   @map("book_id")
  workId           String   @map("work_id") @db.VarChar(32)
  title            String   @db.VarChar(500)
  authorNames      String   @map("author_names") @db.Text
  subjects         String   @db.Text
  firstPublishYear Int?     @map("first_publish_year")
  coverId          Int?     @map("cover_id")
  titleSimilarity  Float    @map("title_similarity")
  authorSimilarity Float    @map("author_similarity")
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([bookId, workId])
  @@index([bookId, titleSimilarity])
  @@map("book_metadata_candidates")
}

model Tag {
  id             String          @id @default(uuid())
  category       BookTagCategory
  name           String          @db.VarChar(191)
  normalizedName String          @map("normalized_name") @db.VarChar(191)
  books          BookTag[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([category, normalizedName])
  @@index([category])
}

model BookTag {
  bookId    String        @map("book_id")
  tagId     String        @map("tag_id")
  source    BookTagSource @default(LIBRARY)
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag       Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@id([bookId, tagId, source])
  @@index([tagId, source])
  @@map("book_tags")
}

model Author {
  id                 String   @id @default(uuid())
  name               String   @unique
  wikidataId         String?  @map("wikidata_id") @db.VarChar(32)
  portraitUrl        String?  @map("portrait_url") @db.Text
  portraitSourceUrl  String?  @map("portrait_source_url") @db.Text
  portraitArtist     String?  @map("portrait_artist") @db.Text
  portraitLicense    String?  @map("portrait_license") @db.VarChar(191)
  portraitLicenseUrl String?  @map("portrait_license_url") @db.Text
  books              Book[]
  createdAt          DateTime @default(now())
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}
