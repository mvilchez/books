// ---------------------------------------------------------------------------
// books — relational schema (PLAN.md Step 2.1)
//
// Replaces the multi-tab Excel ledger with a normalized relational model:
//   Author (1) ──< Book (M) ──> Genre (0..1)
// Author names are de-duplicated into the Author table (1-to-Many); the Genre
// table powers the analytics rankings. The composite unique key keeps
// re-imports idempotent because the same title can legitimately appear on
// multiple yearly tabs.
//
// Target engine: MariaDB, driven by Prisma's `mysql` provider (there is no
// "mariadb" provider). This mirrors db/schema.sql for hand-provisioned
// databases and pairs with a stable Prisma CLI (e.g. Prisma 6.x) that still
// exposes `prisma generate` / `prisma db push`. See the note at the bottom of
// this file about the Prisma 8 RC currently installed in this workspace.
//
// Field mapping rationale (revised after Step 1.2 to match the real source):
//   rating          -> "Puntuación (del 1 al 10)"  : decimal 1–10, Float?
//   totalPages      -> "Paginas"                   : nullable (pre-2014 gaps)
//   readingYear     -> derived from the TAB NAME   : NOT the publication year
//   publicationYear -> "Año" COLUMN (2014+ tabs)   : the book's original year
//   origin/startDate/finishDate -> Origen/Fecha Inicio/Fecha Fin columns
// ---------------------------------------------------------------------------

datasource db {
  provider = "mysql" // MariaDB uses Prisma's "mysql" provider (no "mariadb" provider)
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Reading lifecycle status for a book.
enum ReadingStatus {
  PENDING
  READING
  COMPLETED
  WISH_LIST
}

model Book {
  id              String        @id @default(uuid())
  title           String
  totalPages      Int?          @map("numero_de_paginas") // nullable: pre-2014 gaps
  currentPages    Int           @default(0)
  status          ReadingStatus @default(PENDING)
  rating          Float?        @map("nota_personal") // decimal 0–10 (1–10 scale)
  readingYear     Int           @map("ano") // derived from the TAB NAME
  publicationYear Int?          @map("ano_publicacion") // from the "Año" COLUMN
  origin          String?       @map("origen")
  startDate       DateTime?     @map("fecha_inicio")
  finishDate      DateTime?     @map("fecha_fin")
  authorId        String
  author          Author        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  genreId         String?
  genre           Genre?        @relation(fields: [genreId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Idempotent re-imports: the same title+author can recur across yearly tabs,
  // so readingYear is part of the natural key.
  @@unique([title, authorId, readingYear])
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// TOOLING NOTE (Prisma 8 RC installed here vs. this classic schema):
// This workspace currently has `prisma@8.0.0-rc` + `@prisma/client@7.10`
// installed. That RC is the "Prisma Next" toolchain, whose CLI has no
// `generate`/`validate`/`db push` and whose `orm`/`contract` workflow only
// targets postgres/mongodb (no mysql). To generate the client and push this
// MariaDB schema as PLAN.md intends, install a stable Prisma, e.g.:
//     npm install -D prisma@6 && npm install @prisma/client@6
//     npx prisma validate
//     npx prisma db push
// ---------------------------------------------------------------------------
