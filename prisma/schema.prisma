// ---------------------------------------------------------------------------
// books — relational schema (PLAN.md Step 2.1)
// ---------------------------------------------------------------------------

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Reading lifecycle status for a book.
enum ReadingStatus {
  PENDING
  READING
  COMPLETED
  WISH_LIST
}

enum RecommendationStatus {
  ACTIVE
  DELETED
  MARKED_AS_READ
}

/// Category for book tags
enum BookTagCategory {
  GENRE
  FORMAT
  LANGUAGE
  SUBJECT
  MOOD
}

/// Source for book tags
enum BookTagSource {
  LIBRARY
  OPEN_LIBRARY
}

/// Model for personalized recommendations from Open Library
model PersonalizedRecommendation {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User?     @relation("personalizedRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  workId            String    @map("work_id") @db.VarChar(32) // Open Library work ID
  title             String    @db.VarChar(500)
  author            String
  firstPublishYear  Int?      @map("first_publish_year")
  coverId           Int?      @map("cover_id")
  status            RecommendationStatus @default(ACTIVE) // ACTIVE, DELETED, MARKED_AS_READ
  createdAt         DateTime  @default(now()) @map("created_at")
  readBookId        String?   @map("read_book_id") // ID of the book marked as read (references Book.id)

  @@index([userId, status])
  @@index([userId, workId])
  @@map("personalized_recommendations")
}

/// User preference vectors for recommendation profiling
model UserPreferenceVector {
  id                String    @id @default(uuid())
  userId            String    @map("user_id") @unique
  authorWeights     Json      @default("{}") @map("author_weights")
  genreWeights      Json      @default("{}") @map("genre_weights")
  tagWeights        Json      @default("{}") @map("tag_weights")
  lastGeneratedAt   DateTime? @map("last_generated_at")
  version           Int       @default(1) @map("version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("user_preference_vectors")
}

/// Reading lifecycle status for a book.
model Book {
  id                 String                  @id @default(uuid())
  title              String
  totalPages         Int?                    @map("numero_de_paginas")
  currentPages       Int                     @default(0)
  status             ReadingStatus           @default(PENDING)
  rating             Float?                  @map("nota_personal")
  readingYear        Int                     @map("ano")
  publicationYear    Int?                    @map("ano_publicacion")
  editionKey         String                  @default("") @map("edition_key")
  openLibraryCoverId Int?                    @map("open_library_cover_id")
  openLibraryWorkId  String?                 @map("open_library_work_id") @db.VarChar(32)
  isbn13             String?                 @map("isbn_13") @db.VarChar(13)
  bookFormat         String?                 @map("book_format") @db.VarChar(191)
  metadataCheckedAt  DateTime?               @map("metadata_checked_at")
  synopsis           String?                 @db.Text
  synopsisLanguage   String?                 @map("synopsis_language") @db.VarChar(12)
  synopsisSourceUrl  String?                 @map("synopsis_source_url") @db.Text
  synopsisCheckedAt  DateTime?               @map("synopsis_checked_at")
  seriesName         String?                 @map("series_name") @db.VarChar(191)
  seriesPosition     Float?                  @map("series_position")
  origin             String?                 @map("origen")
  startDate          DateTime?               @map("fecha_inicio")
  finishDate         DateTime?               @map("fecha_fin")
  authorId           String
  author             Author                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                   @relation("userBooks", fields: [userId], references: [id], onDelete: Cascade)
  genreId            String?
  genre              Genre?                  @relation(fields: [genreId], references: [id], onDelete: SetNull)
  tags               BookTag[]
  metadataCandidates BookMetadataCandidate[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([title, authorId, readingYear, editionKey])
  @@index([readingYear, status])
  @@index([userId])
  @@index([userId, readingYear, status])
  @@index([userId, status])
  @@index([userId, rating])
}

/// Book metadata candidates from Open Library search
model BookMetadataCandidate {
  id               String   @id @default(uuid())
  bookId           String   @map("book_id")
  workId           String   @map("work_id") @db.VarChar(32)
  title            String   @db.VarChar(500)
  authorNames      String   @map("author_names") @db.Text
  subjects         String   @db.Text
  firstPublishYear Int?     @map("first_publish_year")
  coverId          Int?     @map("cover_id")
  titleSimilarity  Float    @map("title_similarity")
  authorSimilarity Float    @map("author_similarity")
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([bookId, workId])
  @@index([bookId, titleSimilarity])
  @@map("book_metadata_candidates")
}

/// Tag categories
model Tag {
  id             String          @id @default(uuid())
  category       BookTagCategory
  name           String          @db.VarChar(191)
  normalizedName String          @map("normalized_name") @db.VarChar(191)
  books          BookTag[]
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([category, normalizedName])
  @@index([category])
  @@map("tags")
}

/// Book-Tag relationship
model BookTag {
  bookId    String        @map("book_id")
  tagId     String        @map("tag_id")
  source    BookTagSource @default(LIBRARY)
  deleted   Boolean       @default(false) @map("deleted")
  deletedAt DateTime?     @map("deleted_at")
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag       Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@id([bookId, tagId, source])
  @@index([tagId, source])
  @@index([deleted])
  @@index([bookId, deleted])
  @@index([tagId, deleted])
  @@index([bookId, source, deleted])
  @@map("book_tags")
}

model Author {
  id                 String   @id @default(uuid())
  name               String   @unique
  wikidataId         String?  @map("wikidata_id") @db.VarChar(32)
  nationality        String?  @map("nationality") @db.VarChar(191)
  portraitUrl        String?  @map("portrait_url") @db.Text
  portraitSourceUrl  String?  @map("portrait_source_url") @db.Text
  portraitArtist     String?  @map("portrait_artist") @db.Text
  portraitLicense    String?  @map("portrait_license") @db.VarChar(191)
  portraitLicenseUrl String?  @map("portrait_license_url") @db.Text
  books              Book[]
  createdAt          DateTime @default(now())
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  name         String?
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  books        Book[] @relation("userBooks")
  personalizedRecommendations PersonalizedRecommendation[] @relation("personalizedRecommendations")
  sessions     Session[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

enum UserRole {
  USER
  ADMIN
}
