{
  "mcpServers": {
    "token-cache": {
      "command": "node",
      "args": [
        "/home/marino/.vscode/extensions/sarfudheen.tokensculpt-1.0.19/dist/cache-server.js",
        "/home/marino/Documentos/workspace/books"
      ]
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "env": {
        "HEADROOM_BEACON": "off",
        "HEADROOM_TELEMETRY": "off",
        "HEADROOM_OFFLINE": "1",
        "DO_NOT_TRACK": "1"
      }
    }
  }
}